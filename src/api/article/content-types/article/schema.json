{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "04. Knowledge",
    "description": "Artikel Knowledge & Insights dengan isi utama dari Rich Text Editor"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "maxLength": 300
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "cover": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "carouselImages": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "inversedBy": "articles"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "inversedBy": "articles"
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "videoLink": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
