      "default": "Bantuan"
    },
    "heroDescription": {
      "type": "text"
    },
    "heroBackground": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
