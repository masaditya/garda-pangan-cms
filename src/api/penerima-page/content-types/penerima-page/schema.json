      "type": "string",
      "default": "Testimoni penerima manfaat"
    },
    "testimonialsSubtitle": {
      "type": "text"
    },
    "youtubeTestimonialsUrl": {
      "type": "string",
      "description": "URL YouTube (watch, youtu.be, atau embed) untuk tombol Tonton Testimoni / modal embed."
    },
    "testimonialsVideoPoster": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Thumbnail/poster sampel video testimoni.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
