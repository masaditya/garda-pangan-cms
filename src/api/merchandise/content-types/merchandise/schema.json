{
  "kind": "collectionType",
  "collectionName": "merchandises",
  "info": {
    "singularName": "merchandise",
    "pluralName": "merchandises",
    "displayName": "06. Products",
    "description": "The merchandise products available"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "releaseDate": {
      "type": "date"
    },
    "images": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::merchandise-category.merchandise-category",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "inversedBy": "merchandises"
    },
    "storeLinks": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.store-link",
      "repeatable": true
    }
  }
}
